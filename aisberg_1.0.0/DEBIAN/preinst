#!/bin/bash
set -e

if ! dpkg -s grafana >/dev/null 2>&1; then
    echo "=== [A.I.S.B.E.R.G.] Подготовка Grafana... ==="
    # Скачиваем пакет в /tmp, если его там еще нет
    if [ ! -f /tmp/grafana_10.4.2_amd64.deb ]; then
        wget -q --show-progress -O /tmp/grafana_10.4.2_amd64.deb \
        https://dl.grafana.com/oss/release/grafana_10.4.2_amd64.deb || exit 1
    fi
    echo "=== [A.I.S.B.E.R.G.] Пакет Grafana скачан в /tmp. ==="
fi
exit 0
