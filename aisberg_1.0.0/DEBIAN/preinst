#!/bin/bash
set -e

# Проверка наличия Grafana в системе
if ! dpkg -s grafana >/dev/null 2>&1; then
    echo "=== [A.I.S.B.E.R.G.] Grafana не обнаружена. Запуск автоматической установки... ==="
    TEMP_DEB="/tmp/grafana_10.4.2_amd64.deb"

    # Скачивание официального пакета
    wget -O "$TEMP_DEB" https://dl.grafana.com/oss/release/grafana_10.4.2_amd64.deb || { echo "Ошибка: Не удалось скачать Grafana"; exit 1; }

    # Установка через apt для автоматического разрешения зависимостей (например, musl)
    apt-get update || true
    apt-get install -y "$TEMP_DEB" || apt-get install -f -y

    # Очистка временных файлов
    rm -f "$TEMP_DEB"
else
    echo "=== [A.I.S.B.E.R.G.] Grafana уже установлена. Пропускаю шаг. ==="
fi

exit 0
