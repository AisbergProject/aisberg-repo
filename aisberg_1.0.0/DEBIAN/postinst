#!/bin/sh
set -e
. /usr/share/debconf/confmodule

db_get aisberg/role
ROLE="$RET"

mkdir -p /etc/aisberg
mkdir -p /var/log/aisberg

if [ "$ROLE" = "Server" ]; then
    db_get aisberg/win_ip && WIN_IP="$RET"
    db_get aisberg/minio_url && MINIO_URL="$RET"
    db_get aisberg/cold_days && COLD_DAYS="$RET"

    cat <<EOF > /etc/aisberg/aisberg.conf
ROLE="SERVER"
WINDOWS_IP="$WIN_IP"
MINIO_ENDPOINT="$MINIO_URL"
MIGRATION_DAYS="$COLD_DAYS"
EOF
else
    echo "Настройка роли CLOUD (установка MinIO как службы)..."
    
    # 1. Загружаем бинарник
    curl -L https://dl.min.io/server/minio/release/linux-amd64/minio -o /usr/local/bin/minio
    chmod +x /usr/local/bin/minio
    
    # 2. Создаем папку для данных, если её нет
    mkdir -p /mnt/data
    
    # 3. Сохраняем конфиг
    echo 'ROLE="CLOUD"' > /etc/aisberg/aisberg.conf

# 4. Включаем и запускаем сервис MinIO (ОБНОВЛЕННЫЙ БЛОК С ПРОВЕРКОЙ)
    if [ -f "/lib/systemd/system/minio.service" ]; then
        echo "Активация службы MinIO..."
        systemctl daemon-reload
        systemctl enable minio
        systemctl restart minio
    else
        echo "ПРЕДУПРЕЖДЕНИЕ: Файл minio.service не найден, автозапуск не настроен"
    fi
fi

touch /var/log/aisberg/sync.log
chmod 666 /var/log/aisberg/sync.log

# Перезагружаем конфиги systemd для сервиса aisberg
systemctl daemon-reload

# Если это роль Server, включаем и запускаем основной сервис синхронизации
if [ "$ROLE" = "Server" ]; then
    systemctl enable aisberg
    systemctl restart aisberg
fi

exit 0
