#!/bin/sh
# Прекращать выполнение при любой ошибке (код возврата не 0)
set -e

# Подключаем модуль debconf
. /usr/share/debconf/confmodule

# Читаем роль из базы данных.
db_get aisberg/role || true
ROLE="${RET:-CLOUD}"

# Создаем системные директории.
mkdir -p /etc/aisberg
mkdir -p /var/log/aisberg
mkdir -p /usr/local/bin

# === НОВОЕ: УСТАНОВКА VICTORIAMETRICS (Нужна и серверу и облаку) ===
echo "Проверка VictoriaMetrics..."
if [ ! -f /usr/local/bin/victoria-metrics ]; then
    curl -L https://github.com/VictoriaMetrics/VictoriaMetrics/releases/download/v1.93.0/victoria-metrics-linux-amd64-v1.93.0.tar.gz -o /tmp/vm.tar.gz
    tar -xzf /tmp/vm.tar.gz -C /usr/local/bin/ victoria-metrics-prod
    mv /usr/local/bin/victoria-metrics-prod /usr/local/bin/victoria-metrics
    chmod +x /usr/local/bin/victoria-metrics
fi

# Создаем сервис для VictoriaMetrics (чтобы мониторинг работал всегда)
cat <<EOF > /etc/systemd/system/victoriametrics.service
[Unit]
Description=VictoriaMetrics
After=network.target

[Service]
ExecStart=/usr/local/bin/victoria-metrics -retentionPeriod=1
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload || true
systemctl enable victoriametrics || true
systemctl restart victoriametrics || true
# =================================================================

if [ "$ROLE" = "Server" ]; then
    # Безопасно получаем параметры для сервера
    db_get aisberg/win_ip || true
    WIN_IP="${RET:-192.168.1.10}"
    
    db_get aisberg/minio_url || true
    MINIO_URL="${RET:-http://localhost:9000}"
    
    db_get aisberg/cold_days || true
    COLD_DAYS="${RET:-30}"

    # === НОВОЕ: УСТАНОВКА MC (MinIO Client для авто-создания бакетов) ===
    echo "Установка MinIO Client..."
    curl -L https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc
    chmod +x /usr/local/bin/mc
    # =================================================================

    cat <<EOF > /etc/aisberg/aisberg.conf
ROLE="SERVER"
WINDOWS_IP="$WIN_IP"
MINIO_ENDPOINT="$MINIO_URL"
MIGRATION_DAYS="$COLD_DAYS"
EOF
else
    echo "Настройка роли CLOUD (установка MinIO как службы)..."
    
    # 1. Загружаем бинарник. 
    mkdir -p /usr/local/bin
    curl -L https://dl.min.io/server/minio/release/linux-amd64/minio -o /usr/local/bin/minio || echo "Не удалось скачать MinIO"
    
    # Устанавливаем права только если файл скачался
    [ -f /usr/local/bin/minio ] && chmod +x /usr/local/bin/minio
    
    # 2. Создаем папку для данных
    mkdir -p /mnt/data
    
    # 3. Сохраняем конфиг
    echo 'ROLE="CLOUD"' > /etc/aisberg/aisberg.conf

    # 4. Включаем и запускаем сервис MinIO
    systemctl daemon-reload || true
    systemctl enable minio || true
    systemctl restart minio || true
fi

# Создаем лог-файл
touch /var/log/aisberg/sync.log
chmod 666 /var/log/aisberg/sync.log

# Перезагружаем конфиги systemd
systemctl daemon-reload || true

# Если это роль Server, запускаем основной сервис синхронизации
if [ "$ROLE" = "Server" ]; then
    systemctl enable aisberg || true
    systemctl restart aisberg || true
fi

exit 0
